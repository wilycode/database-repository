{
    "name": "wilycode/database-repository",
    "description": "Model repositories for PHP with eager loading, safe CRUD, relationship persistence and pagination.",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.4",
        "ext-ctype": "*",
        "ext-mbstring": "*",
        "wilycode/database-model": "^0.1",
        "wilycode/database-query": "^0.2",
        "wilycode/database-query-executor": "^0.2"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0",
        "wilycode/database-pdo": "^0.1.2"
    },
    "autoload": {
        "psr-4": {
            "WilyCode\\Database\\Repository\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "WilyCode\\Database\\Repository\\Tests\\": "tests/"
        }
    },
    "authors": [
        {
            "name": "Simon Piter"
        }
    ],
    "scripts": {
        "test": "phpunit"
    },
    "extra": {
        "branch-alias": {
            "dev-main": "0.2.x-dev"
        }
    },
    "archive": {
        "exclude": [
            "/tests",
            "/examples",
            "/docs",
            "/benchmark",
            "/benchmarks",
            "/tools",
            "/phpunit.xml",
            "/phpunit.xml.dist",
            "/AGENTS.md",
            "/CHANGELOG.md",
            "/CONTRIBUTING.md",
            "/CODE_OF_CONDUCT.md",
            "/SECURITY.md",
            "/composer.lock",
            "/.github",
            "/.gitignore",
            "/.gitattributes",
            "/.editorconfig",
            "/.phpunit.cache",
            "/.phpunit.result.cache",
            "/phpstan.neon",
            "/phpstan.neon.dist",
            "/phpstan.*.neon",
            "/phpstan.*.neon.dist",
            "/pint.json",
            "/rector.php",
            "/psalm.xml",
            "/psalm.xml.dist",
            "/infection.json",
            "/infection.json.dist"
        ]
    },
    "keywords": [
        "wilycode",
        "database",
        "repository",
        "orm",
        "query-builder",
        "models",
        "eager-loading",
        "relationships",
        "pagination",
        "php"
    ],
    "homepage": "https://github.com/wilycode/database-repository",
    "support": {
        "issues": "https://github.com/wilycode/database-repository/issues",
        "source": "https://github.com/wilycode/database-repository"
    }
}
